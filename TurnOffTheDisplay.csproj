<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>default</LangVersion>
        <!-- バージョンは Directory.Build.props の <Version> で一元管理 (継承)。 -->
        <Title>ディスプレイ＠OFF</Title>
        <Authors>ゆろち</Authors>
        <Description>ディスプレイをスタンバイモードに移行するソフトです。
電源プランのディスプレイの電源を切る時と同じ動作を実行します。
席を外す際や、PCを起動させたままでディスプレイをスタンバイモードに移行させたい場合などにお使いください。</Description>
        <NeutralLanguage>ja-JP</NeutralLanguage>
        <SupportedOSPlatformVersion>8.0</SupportedOSPlatformVersion>
        <ApplicationIcon>icon\app.ico</ApplicationIcon>
        <AssemblyTitle>ディスプレイ＠OFF</AssemblyTitle>
        <AssemblyDescription>ディスプレイをスタンバイモードに移行するソフト</AssemblyDescription>
        <AssemblyCompany>ゆろち</AssemblyCompany>
        <AssemblyProduct>ディスプレイ＠OFF</AssemblyProduct>
        <AssemblyCopyright>Copyright © 2025 ゆろち</AssemblyCopyright>
        <PackageIcon>app_icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/1llum1n4t1s/TurnOffTheDisplay</RepositoryUrl>
        <!-- ネイティブAOT: Publish 時に -r win-x64 で指定 -->
        <PublishAot>true</PublishAot>
        <!-- 通常 build でも AOT/トリム アナライザを有効化し退行を早期検出 (テスト不在の保険) -->
        <IsAotCompatible>true</IsAotCompatible>
        <!-- AOT バンドルサイズ削減: 本アプリは固定文言/序数比較のみでカルチャ(ICU)・ETW・分散トレース不要 -->
        <InvariantGlobalization>true</InvariantGlobalization>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <EventSourceSupport>false</EventSourceSupport>
        <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <PlatformTarget>x64</PlatformTarget>
        <Platforms>x64</Platforms>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
      <DebugType>embedded</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
      <DebugType>embedded</DebugType>
      <!-- Release 配布物ではデバッガ補助コードを除去 (サイズ削減) -->
      <DebuggerSupport>false</DebuggerSupport>
    </PropertyGroup>

    <PropertyGroup>
      <EnableDefaultPageItems>false</EnableDefaultPageItems>
      <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    </PropertyGroup>

    <ItemGroup>
      <None Remove=".gitignore" />
      <None Remove="LICENSE" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaResource Include="App.xaml" />
      <AvaloniaResource Include="MainWindow.xaml" />
      <AvaloniaResource Include="icon\app.ico" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia" Version="12.0.4" />
      <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
      <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="Velopack" Version="1.2.0" />
    </ItemGroup>

    <ItemGroup>
      <None Update="icon\app_icon.png">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
      <None Update="README.md">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
    </ItemGroup>

</Project>
